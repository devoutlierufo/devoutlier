<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <title>UAP Gerb Conclusions</title>
</head>

<body>

  <h1>UAP Gerb Conclusions</h1>

  <div id="player"></div>

  <script>
    // Load YouTube's IFrame Player API
    const tag = document.createElement('script');
    tag.src = "https://www.youtube.com/iframe_api";

    const firstScriptTag = document.getElementsByTagName('script')[0];
    firstScriptTag.parentNode.insertBefore(tag, firstScriptTag);

    // YouTube calls this automatically once the API is ready
    let player;

    function onYouTubeIframeAPIReady() {
      player = new YT.Player('player', {
        height: '390',
        width: '640',
        videoId: '107BtDYhTkA'
      });
    }
  </script>

</body>
</html>
